# ---------------------------------------------------------------------------
# Portfolio — environment variables
# Copy this file to `.env` (git-ignored) and fill in your own values.
# Never commit real secrets: this example file is versioned.
# ---------------------------------------------------------------------------

# --- Frontend (public: values prefixed with VITE_ reach the browser) --------
# Endpoint called by the contact form.
#   • "/api/contact"  -> bundled serverless function (default, recommended)
#   • absolute URL    -> external service, e.g. "https://formspree.io/f/xxxxx"
VITE_CONTACT_ENDPOINT="/api/contact"

# --- Backend only (server side: never exposed to the browser) --------------
# Resend API key — create it on https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Inbox that receives the messages. Several addresses: separate with a comma.
CONTACT_EMAIL="your-email@example.com"

# Optional: verified sender. Without it, Resend's test sender
# (onboarding@resend.dev) is used, and it only delivers to the address that owns
# the Resend account. Verify a domain to send from your own address.
# CONTACT_FROM_EMAIL="Portfolio <contact@your-domain.com>"
